from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
SAFE_BATCH = REPO_ROOT / "scripts" / "content" / "safe_power_batch.py"


def _utf8_env() -> dict[str, str]:
    env = os.environ.copy()
    env["PYTHONUTF8"] = "1"
    env["PYTHONIOENCODING"] = "utf-8"
    return env


def _safe_write(value: str) -> None:
    encoding = getattr(sys.stdout, "encoding", None) or "utf-8"
    try:
        sys.stdout.write(value)
    except UnicodeEncodeError:
        sys.stdout.write(value.encode(encoding, errors="replace").decode(encoding, errors="replace"))
    sys.stdout.flush()


def run(args: list[str]) -> tuple[int, str]:
    proc = subprocess.run(
        [sys.executable, str(SAFE_BATCH), *args],
        cwd=REPO_ROOT,
        text=True,
        capture_output=True,
        encoding="utf-8",
        errors="replace",
        env=_utf8_env(),
    )
    out = (proc.stdout or "") + (proc.stderr or "")
    _safe_write(out if out.endswith("\n") else out + "\n")
    return proc.returncode, out


def parse_status(out: str) -> dict[str, int]:
    labels = {
        "Eligible ingested units": "eligible",
        "POWER-ready": "ready",
        "QA-passed awaiting activation": "qa_wait",
        "Validated awaiting QA": "validated_wait",
        "Draft needs regeneration/fix": "draft_fix",
        "Not started": "not_started",
    }
    result: dict[str, int] = {}
    for label, key in labels.items():
        m = re.search(rf"^{re.escape(label)}:\s*(\d+)\s*$", out, re.MULTILINE)
        if m:
            result[key] = int(m.group(1))
    return result


def get_status(grade: int) -> dict[str, int]:
    rc, out = run(["--grade", str(grade), "--status-only"])
    if rc != 0:
        raise SystemExit(rc)
    st = parse_status(out)
    if "eligible" not in st or "ready" not in st:
        print("[STOP] Could not parse grade status.")
        raise SystemExit(30)
    return st


def clean_complete(st: dict[str, int]) -> bool:
    return (
        st.get("eligible", -1) >= 0
        and st.get("ready") == st.get("eligible")
        and st.get("qa_wait", 0) == 0
        and st.get("validated_wait", 0) == 0
        and st.get("draft_fix", 0) == 0
        and st.get("not_started", 0) == 0
    )


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--grade", type=int, choices=[10, 11, 12], required=True)
    ap.add_argument("--limit", type=int, default=5)
    args = ap.parse_args()

    if not SAFE_BATCH.exists():
        print(f"[STOP] Missing safe batch runner: {SAFE_BATCH}")
        return 31

    st = get_status(args.grade)

    if st["eligible"] == 0:
        print("[STOP] No eligible ingested units.")
        return 32

    if clean_complete(st):
        print(f"[DONE] Grade {args.grade} is already fully POWER-ready.")
        return 0

    previous_ready = st["ready"]
    batch_no = 0

    while True:
        batch_no += 1
        print(
            f"\n######## GRADE {args.grade} - SAFE BATCH {batch_no} "
            f"- READY {previous_ready}/{st['eligible']} ########\n"
        )

        rc, out = run(["--grade", str(args.grade), "--limit", str(args.limit)])
        if rc != 0:
            print(
                f"\n[STOP] Grade {args.grade} stopped safely at "
                f"{previous_ready}/{st['eligible']} POWER-ready."
            )
            print("Nothing after the failing batch was activated.")
            return rc

        st = parse_status(out)
        if "eligible" not in st or "ready" not in st:
            st = get_status(args.grade)

        if clean_complete(st):
            print(f"\n[DONE] Grade {args.grade}: {st['ready']}/{st['eligible']} POWER-ready.")
            return 0

        if st.get("ready", previous_ready) <= previous_ready:
            print("\n[STOP] No increase in POWER-ready count; stopping to avoid a loop.")
            return 33

        previous_ready = st["ready"]


if __name__ == "__main__":
    raise SystemExit(main())
