# -------------------------------
# POWER AI local foundation v0.3
# -------------------------------

# PostgreSQL
POSTGRES_DB=power_ai
POSTGRES_USER=power_ai
POSTGRES_PASSWORD=power_ai_local
DATABASE_URL=postgresql+psycopg://power_ai:power_ai_local@localhost:5432/power_ai

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=demo-power-ai
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# OpenAI (server-side only; never expose this in NEXT_PUBLIC_* variables)
OPENAI_API_KEY=
AI_PROVIDER=mock
TUTOR_MODEL=gpt-5.6-luna

# Direct scanned-PDF reading
# Set VISION_PROVIDER=openai when you want to ingest image-only textbook PDFs.
VISION_PROVIDER=disabled
VISION_MODEL=gpt-5.6-luna
VISION_MIN_TEXT_CHARS=80
VISION_RENDER_SCALE=2.0
VISION_CACHE_DIR=storage/ingestion-cache

# Knowledge ingestion / retrieval
# local_hash remains available for free plumbing tests.
# For semantic retrieval set EMBEDDING_PROVIDER=openai.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
INGEST_CHUNK_MAX_CHARS=2400
INGEST_CHUNK_OVERLAP_CHARS=250

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AUTH_MODE=firebase
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-power-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-power-ai
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:demo

# Optional local dev fallback (never use in production)
DEV_USER_EMAIL=student@power.local
DEV_USER_NAME=POWER Student
