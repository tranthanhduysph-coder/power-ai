# ============================================================
# POWER AI - Git ignore rules
# Commit source code, migrations, seeds, docs, lockfiles, and
# example env files. Never commit secrets, local runtime data,
# source textbooks/PDFs, generated caches, or build artifacts.
# ============================================================

# ---------- Node / Next.js ----------
node_modules/
.next/
out/
dist/
.turbo/
.vercel/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IMPORTANT: keep package-lock.json / pnpm-lock.yaml / yarn.lock tracked.

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
build/
*.egg-info/
.ipynb_checkpoints/

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example
!.env.*.example

# Private keys / credentials
*.pem
*.key
*.p12
*.pfx
*service-account*.json
*service_account*.json
*firebase-adminsdk*.json
*credentials*.json
client_secret*.json

# ---------- Firebase local runtime ----------
.firebase/
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*
*-debug.log

# Keep these tracked:
# firebase.json
# .firebaserc

# ---------- Local storage / uploaded content ----------
storage/*
!storage/.gitkeep
uploads/
private/
private_sources/
local-data/
tmp/
temp/

# POWER knowledge-source books are private runtime assets, not Git assets.
*.pdf

# ---------- Local databases / dumps ----------
*.db
*.sqlite
*.sqlite3
*.dump
*.bak
*.backup

# ---------- Logs ----------
*.log
logs/

# ---------- IDE / OS ----------
.vscode/
.idea/
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ---------- Misc local tooling ----------
.cache/
.eslintcache
.nyc_output/
