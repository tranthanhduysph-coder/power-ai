# -------------------------------
# POWER AI repository exclusions
# -------------------------------

# Environment / secrets
.env
.env.*
!.env.example
!.env.*.example
apps/web/.env.local
*service-account*.json
*service_account*.json
firebase-admin*.json
firebase-adminsdk*.json
client_secret*.json
*.pem
*.key

# Node / Next.js
node_modules/
.next/
out/
.npm/
.pnpm-store/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# IDE / OS
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Logs / Firebase emulator runtime
*.log
.firebase/
firebase-debug.log
*-debug.log

# Local databases / dumps
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
postgres-data/

# Private knowledge sources and uploads
private_sources/*
!private_sources/.gitkeep
storage/*
!storage/.gitkeep
uploads/
private/

# Source books / copyrighted documents must not enter Git
*.pdf

# Local PostgreSQL backups
local_backups/*
!local_backups/.gitkeep

# Local-only release artifacts
firebase-data/
*.bak
hotfix_*/
LOCAL_BUILD_COMPLETE.txt
